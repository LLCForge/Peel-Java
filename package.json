{
  "name": "peel-java",
  "version": "0.1.0",
  "description": "Open-source Java and Android bytecode deobfuscator that runs in your browser. Your files never leave your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peel-java": "bin/peel-java.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLCForge/Peel-Java.git"
  },
  "homepage": "https://github.com/LLCForge/Peel-Java#readme",
  "keywords": [
    "deobfuscator",
    "java",
    "android",
    "apk",
    "dex",
    "jar",
    "proguard",
    "r8",
    "malware-analysis",
    "reverse-engineering",
    "security"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fixtures": "node scripts/make-fixtures.js",
    "test": "node test/run.js && node test/all.js",
    "bench": "node test/bench.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  }
}
